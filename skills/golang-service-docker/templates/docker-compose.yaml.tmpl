# Generated by service-docker-scaffold. Edit the skill inputs and rerender
# instead of hand-merging dependency files.

services:
  {{SERVICE_NAME}}:
    image: ${IMAGE_REPOSITORY:-{{IMAGE_REPOSITORY}}}:${IMAGE_TAG:-latest}
    build:
      context: "{{BUILD_CONTEXT}}"
      dockerfile: "{{DOCKERFILE_PATH}}"
    environment:
      - {{ENV_PREFIX}}_SERVER_GRPC_ADDR=${{{ENV_PREFIX}}_SERVER_GRPC_ADDR:-:{{EXPOSE_PORT}}}
      # --- IF gateway ---
      - {{ENV_PREFIX}}_SERVER_HTTP_ADDR=${{{ENV_PREFIX}}_SERVER_HTTP_ADDR:-:{{HTTP_PORT}}}
      # --- END gateway ---
      - {{ENV_PREFIX}}_LOG_LEVEL=${{{ENV_PREFIX}}_LOG_LEVEL:-info}
      # --- IF postgres ---
      - {{ENV_PREFIX}}_DATABASE_HOST=${{{ENV_PREFIX}}_DATABASE_HOST:-postgres}
      - {{ENV_PREFIX}}_DATABASE_PORT=${{{ENV_PREFIX}}_DATABASE_PORT:-5432}
      - {{ENV_PREFIX}}_DATABASE_USER=${{{ENV_PREFIX}}_DATABASE_USER:-postgres}
      - {{ENV_PREFIX}}_DATABASE_PASSWORD=${{{ENV_PREFIX}}_DATABASE_PASSWORD:-postgres}
      - {{ENV_PREFIX}}_DATABASE_DBNAME=${{{ENV_PREFIX}}_DATABASE_DBNAME:-{{DATABASE_NAME}}}
      - {{ENV_PREFIX}}_DATABASE_SSLMODE=${{{ENV_PREFIX}}_DATABASE_SSLMODE:-disable}
      # --- END postgres ---
      # --- IF mysql ---
      - {{ENV_PREFIX}}_DATABASE_HOST=${{{ENV_PREFIX}}_DATABASE_HOST:-mysql}
      - {{ENV_PREFIX}}_DATABASE_PORT=${{{ENV_PREFIX}}_DATABASE_PORT:-3306}
      - {{ENV_PREFIX}}_DATABASE_USER=${{{ENV_PREFIX}}_DATABASE_USER:-mysql}
      - {{ENV_PREFIX}}_DATABASE_PASSWORD=${{{ENV_PREFIX}}_DATABASE_PASSWORD:-mysql}
      - {{ENV_PREFIX}}_DATABASE_DBNAME=${{{ENV_PREFIX}}_DATABASE_DBNAME:-{{DATABASE_NAME}}}
      # --- END mysql ---
      # --- IF redis ---
      - {{ENV_PREFIX}}_REDIS_ADDR=${{{ENV_PREFIX}}_REDIS_ADDR:-redis:6379}
      - {{ENV_PREFIX}}_REDIS_USERNAME=${{{ENV_PREFIX}}_REDIS_USERNAME:-}
      - {{ENV_PREFIX}}_REDIS_PASSWORD=${{{ENV_PREFIX}}_REDIS_PASSWORD:-}
      - {{ENV_PREFIX}}_REDIS_DB=${{{ENV_PREFIX}}_REDIS_DB:-0}
      # --- END redis ---
      {{CONFIG_ENVIRONMENT_LINES}}
    ports:
      - "${HOST_GRPC_PORT:-{{EXPOSE_PORT}}}:{{EXPOSE_PORT}}"
      # --- IF gateway ---
      - "${HOST_HTTP_PORT:-{{HTTP_PORT}}}:{{HTTP_PORT}}"
      # --- END gateway ---
    # --- IF config_mount ---
    volumes:
      - "${CONFIG_FILE:-./{{CONFIG_SOURCE}}}:/app/config.yaml:ro"
    # --- END config_mount ---
    # --- IF dependencies ---
    depends_on:
      # --- IF postgres ---
      postgres:
        condition: service_healthy
      # --- END postgres ---
      # --- IF mysql ---
      mysql:
        condition: service_healthy
      # --- END mysql ---
      # --- IF redis ---
      redis:
        condition: service_healthy
      # --- END redis ---
    # --- END dependencies ---
    healthcheck:
      test: ["CMD", "grpc_health_probe", "-addr=127.0.0.1:{{EXPOSE_PORT}}", "-connect-timeout=2s"]
      interval: ${HEALTHCHECK_INTERVAL:-10s}
      timeout: ${HEALTHCHECK_TIMEOUT:-3s}
      retries: ${HEALTHCHECK_RETRIES:-6}
      start_period: ${HEALTHCHECK_START_PERIOD:-10s}

  # --- IF postgres ---
  postgres:
    image: ${POSTGRES_IMAGE:-postgres:17-alpine}
    environment:
      - POSTGRES_DB=${{{ENV_PREFIX}}_DATABASE_DBNAME:-{{DATABASE_NAME}}}
      - POSTGRES_USER=${{{ENV_PREFIX}}_DATABASE_USER:-postgres}
      - POSTGRES_PASSWORD=${{{ENV_PREFIX}}_DATABASE_PASSWORD:-postgres}
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${{{ENV_PREFIX}}_DATABASE_USER:-postgres}"]
      interval: ${POSTGRES_HEALTHCHECK_INTERVAL:-3s}
      timeout: ${POSTGRES_HEALTHCHECK_TIMEOUT:-3s}
      retries: ${POSTGRES_HEALTHCHECK_RETRIES:-20}
      start_period: ${POSTGRES_HEALTHCHECK_START_PERIOD:-10s}
  # --- END postgres ---

  # --- IF mysql ---
  mysql:
    image: ${MYSQL_IMAGE:-mysql:8}
    environment:
      - MYSQL_DATABASE=${{{ENV_PREFIX}}_DATABASE_DBNAME:-{{DATABASE_NAME}}}
      - MYSQL_USER=${{{ENV_PREFIX}}_DATABASE_USER:-mysql}
      - MYSQL_PASSWORD=${{{ENV_PREFIX}}_DATABASE_PASSWORD:-mysql}
      - MYSQL_ROOT_PASSWORD=${{{ENV_PREFIX}}_DATABASE_ROOT_PASSWORD:-root}
    ports:
      - "${MYSQL_PORT:-3306}:3306"
    volumes:
      - mysqldata:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u ${{{ENV_PREFIX}}_DATABASE_USER:-mysql} -p${{{ENV_PREFIX}}_DATABASE_PASSWORD:-mysql}"]
      interval: ${MYSQL_HEALTHCHECK_INTERVAL:-3s}
      timeout: ${MYSQL_HEALTHCHECK_TIMEOUT:-3s}
      retries: ${MYSQL_HEALTHCHECK_RETRIES:-20}
      start_period: ${MYSQL_HEALTHCHECK_START_PERIOD:-15s}
  # --- END mysql ---

  # --- IF redis ---
  redis:
    image: ${REDIS_IMAGE:-redis:7-alpine}
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: ${REDIS_HEALTHCHECK_INTERVAL:-3s}
      timeout: ${REDIS_HEALTHCHECK_TIMEOUT:-3s}
      retries: ${REDIS_HEALTHCHECK_RETRIES:-20}
      start_period: ${REDIS_HEALTHCHECK_START_PERIOD:-3s}
  # --- END redis ---

# --- IF dependencies ---
volumes:
  # --- IF postgres ---
  pgdata:
    name: ${POSTGRES_VOLUME:-{{SERVICE_NAME}}-pgdata}
  # --- END postgres ---
  # --- IF mysql ---
  mysqldata:
    name: ${MYSQL_VOLUME:-{{SERVICE_NAME}}-mysqldata}
  # --- END mysql ---
  # --- IF redis ---
  redisdata:
    name: ${REDIS_VOLUME:-{{SERVICE_NAME}}-redisdata}
  # --- END redis ---
# --- END dependencies ---
