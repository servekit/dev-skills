# Generated by golang-service-docker.
# Copy to .env for local overrides. Do not commit real production secrets.

# Stable image identity used by Compose and generated Makefile targets.
IMAGE_REPOSITORY={{IMAGE_REPOSITORY}}
IMAGE_TAG=latest

# Host port can differ while the container continues listening on the grpcx
# port selected during rendering.
# HOST_GRPC_PORT={{EXPOSE_PORT}}
# --- IF gateway ---
# grpc-gateway listens inside the container on {{HTTP_PORT}}. Override only the
# host side when the default port is already occupied.
# HOST_HTTP_PORT={{HTTP_PORT}}
# --- END gateway ---

# Application settings. Add only variables the binary actually reads.
# {{ENV_PREFIX}}_SERVER_GRPC_ADDR=:{{EXPOSE_PORT}}
# --- IF gateway ---
# {{ENV_PREFIX}}_SERVER_HTTP_ADDR=:{{HTTP_PORT}}
# --- END gateway ---
# {{ENV_PREFIX}}_LOG_LEVEL=info
{{CONFIG_ENV_EXAMPLE_LINES}}

# --- IF config_copy ---
# The non-secret template {{CONFIG_SOURCE}} is baked into the image as
# /app/config.yaml. Values such as ${VAR} are expanded by the application from
# the container environment at startup.
# --- END config_copy ---

# --- IF config_mount ---
# Mount mode replaces /app/config.yaml with a host file at runtime.
CONFIG_FILE=./{{CONFIG_SOURCE}}
# --- END config_mount ---

# Healthcheck timing overrides.
# HEALTHCHECK_INTERVAL=10s
# HEALTHCHECK_TIMEOUT=3s
# HEALTHCHECK_RETRIES=6
# HEALTHCHECK_START_PERIOD=10s

# --- IF postgres ---
{{ENV_PREFIX}}_DATABASE_USER=postgres
{{ENV_PREFIX}}_DATABASE_PASSWORD=replace-me
{{ENV_PREFIX}}_DATABASE_DBNAME={{DATABASE_NAME}}
# POSTGRES_IMAGE=postgres:17-alpine
# POSTGRES_PORT=5432
# POSTGRES_VOLUME={{SERVICE_NAME}}-pgdata
# POSTGRES_HEALTHCHECK_INTERVAL=3s
# POSTGRES_HEALTHCHECK_TIMEOUT=3s
# POSTGRES_HEALTHCHECK_RETRIES=20
# POSTGRES_HEALTHCHECK_START_PERIOD=10s
# --- END postgres ---

# --- IF mysql ---
{{ENV_PREFIX}}_DATABASE_USER=mysql
{{ENV_PREFIX}}_DATABASE_PASSWORD=replace-me
{{ENV_PREFIX}}_DATABASE_ROOT_PASSWORD=replace-me-root
{{ENV_PREFIX}}_DATABASE_DBNAME={{DATABASE_NAME}}
# MYSQL_IMAGE=mysql:8
# MYSQL_PORT=3306
# MYSQL_VOLUME={{SERVICE_NAME}}-mysqldata
# MYSQL_HEALTHCHECK_INTERVAL=3s
# MYSQL_HEALTHCHECK_TIMEOUT=3s
# MYSQL_HEALTHCHECK_RETRIES=20
# MYSQL_HEALTHCHECK_START_PERIOD=15s
# --- END mysql ---

