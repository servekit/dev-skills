# Environment template. Copy to .env and edit:
#   cp .env.example .env
#
# These values are docker-compose oriented (hostnames are compose service
# names). config.example.yaml references every value via ${VAR}, expanded by
# configx at startup. The binary never reads this file directly — load it into
# the environment:
#   - local binary (make run): godotenv loads .env automatically
#   - docker compose: reads .env for ${VAR} interpolation
#
# For LOCAL binary runs, change docker hostnames to local addresses:
#   DEMO_SERVICE_DATABASE_HOST: postgres -> localhost
#
# Never commit real production secrets — keep them in .env (gitignored), the CI
# secret store, or the deployment secret manager.

DEMO_SERVICE_SERVER_GRPC_ADDR=:9000
DEMO_SERVICE_SERVER_HTTP_ADDR=:8080

DEMO_SERVICE_DATABASE_HOST=postgres
DEMO_SERVICE_DATABASE_PORT=5432
DEMO_SERVICE_DATABASE_USER=postgres
DEMO_SERVICE_DATABASE_PASSWORD=postgres
DEMO_SERVICE_DATABASE_DBNAME=demo_service
DEMO_SERVICE_DATABASE_SSLMODE=disable
DEMO_SERVICE_DATABASE_MAX_OPEN_CONNS=25
DEMO_SERVICE_DATABASE_MAX_IDLE_CONNS=10
DEMO_SERVICE_DATABASE_CONN_MAX_LIFETIME=5m

DEMO_SERVICE_THIRD_PARTY_DEMO_MODE=module
DEMO_SERVICE_THIRD_PARTY_DEMO_TARGET=
DEMO_SERVICE_THIRD_PARTY_DEMO_CONFIG_PREFIX=[demo]
DEMO_SERVICE_THIRD_PARTY_DEMO_CONFIG_MAX_INPUT_LEN=1024

DEMO_SERVICE_CRON_TIMEZONE=Asia/Shanghai

DEMO_SERVICE_LOG_LEVEL=info
DEMO_SERVICE_LOG_FORMAT=json
