# Environment template. Copy to .env and edit:
#   cp .env.example .env
#
# These values are docker-compose oriented (hostnames are compose service
# names). config.example.yaml references every value via ${VAR}, expanded by
# configx at startup. The binary never reads this file directly — load it into
# the environment:
#   - local binary (make run): godotenv loads .env automatically
#   - docker compose: reads .env for ${VAR} interpolation
#
# For LOCAL binary runs, change docker hostnames to local addresses:
#   {{.EnvPrefix}}_DATABASE_HOST: postgres -> localhost
#
# Never commit real production secrets — keep them in .env (gitignored), the CI
# secret store, or the deployment secret manager.

{{.EnvPrefix}}_SERVER_GRPC_ADDR=:9000
{{.EnvPrefix}}_SERVER_HTTP_ADDR=:8080

{{.EnvPrefix}}_DATABASE_HOST=postgres
{{.EnvPrefix}}_DATABASE_PORT=5432
{{.EnvPrefix}}_DATABASE_USER=postgres
{{.EnvPrefix}}_DATABASE_PASSWORD=postgres
{{.EnvPrefix}}_DATABASE_DBNAME={{.Name}}_service
{{.EnvPrefix}}_DATABASE_SSLMODE=disable
{{.EnvPrefix}}_DATABASE_MAX_OPEN_CONNS=25
{{.EnvPrefix}}_DATABASE_MAX_IDLE_CONNS=10
{{.EnvPrefix}}_DATABASE_CONN_MAX_LIFETIME=5m

{{.EnvPrefix}}_THIRD_PARTY_DEMO_MODE=module
{{.EnvPrefix}}_THIRD_PARTY_DEMO_TARGET=
{{.EnvPrefix}}_THIRD_PARTY_DEMO_CONFIG_PREFIX=[demo]
{{.EnvPrefix}}_THIRD_PARTY_DEMO_CONFIG_MAX_INPUT_LEN=1024

{{.EnvPrefix}}_CRON_TIMEZONE=Asia/Shanghai

{{.EnvPrefix}}_LOG_LEVEL=info
{{.EnvPrefix}}_LOG_FORMAT=json
