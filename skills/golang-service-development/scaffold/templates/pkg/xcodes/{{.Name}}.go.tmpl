// Package xcodes defines {{.Module}} error codes. Group domain errors into
// per-domain files (one per major capability area); generic codes live in
// go-common's xerr package and are re-exported here as needed.
//
// Usage:
//
//	if err != nil {
//	    return nil, xcodes.Err{{.Pascal}}NotFound.Wrapf(err, "{{.Name}} id=%d", id)
//	}
//
// See go-common-usage skill §xerr for the full xerr API.
package xcodes

import "github.com/servekit/go-common/xerr"

// {{.Pascal}}-domain error codes.
var (
	Err{{.Pascal}}Internal     = xerr.New("{{.NameUpper}}_INTERNAL", xerr.CategoryInternal, 500, "internal error")
	Err{{.Pascal}}InvalidInput = xerr.New("{{.NameUpper}}_INVALID_INPUT", xerr.CategoryBadRequest, 400, "invalid input")
	Err{{.Pascal}}NotFound     = xerr.New("{{.NameUpper}}_NOT_FOUND", xerr.CategoryNotFound, 404, "{{.Name}} not found")
	Err{{.Pascal}}Conflict     = xerr.New("{{.NameUpper}}_CONFLICT", xerr.CategoryConflict, 409, "{{.Name}} already exists")
)
