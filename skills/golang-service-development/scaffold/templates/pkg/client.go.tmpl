package pkg

import (
	{{.Name}}v1 "{{.Module}}/gen/{{.Name}}/v1"

	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials/insecure"
)

// Client is a gRPC client for {{.Module}}.
//
// Embeds {{.Name}}v1.{{.Pascal}}ServiceClient so callers can invoke RPCs directly:
//
//	c, _ := pkg.NewClient("localhost:9000")
//	{{.Name}}, _ := c.Get{{.Pascal}}(ctx, &{{.Name}}v1.Get{{.Pascal}}Request{Id: 1})
type Client struct {
	conn *grpc.ClientConn
	{{.Name}}v1.{{.Pascal}}ServiceClient
}

// NewClient dials {{.Module}} at addr using insecure credentials by default.
// Pass additional DialOptions (e.g., credentials) to override.
func NewClient(addr string, opts ...grpc.DialOption) (*Client, error) {
	dialOpts := append([]grpc.DialOption{
		grpc.WithTransportCredentials(insecure.NewCredentials()),
	}, opts...)

	conn, err := grpc.NewClient(addr, dialOpts...)
	if err != nil {
		return nil, err
	}

	return &Client{
		conn:              conn,
		{{.Pascal}}ServiceClient: {{.Name}}v1.New{{.Pascal}}ServiceClient(conn),
	}, nil
}

// Close releases the underlying gRPC connection.
func (c *Client) Close() error { return c.conn.Close() }
