// Get{{.Pascal}} returns the {{.Name}} with the given primary key, or gorm.ErrRecordNotFound.
//
// gorm.G[T].Take returns a value type T (not *T); we take its address so the
// caller receives a pointer consistent with Create{{.Pascal}}'s input.
func Get{{.Pascal}}(ctx context.Context, tx *gorm.DB, id int64) (*models.{{.Pascal}}, error) {
	d, err := gorm.G[models.{{.Pascal}}](tx).
		Where(generated.{{.Pascal}}.ID.Eq(id)).
		Take(ctx)
	if err != nil {
		return nil, err
	}
	return &d, nil
}

