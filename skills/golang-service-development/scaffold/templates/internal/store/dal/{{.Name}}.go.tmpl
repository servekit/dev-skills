// gorm.G[T].Find returns []T (not []*T); we convert to []*T to match the
// pointer-style convention used elsewhere in the dal layer.
func List{{.Pascal}}s(ctx context.Context, tx *gorm.DB, limit, offset int) ([]*models.{{.Pascal}}, error) {
	{{.Plural}}, err := gorm.G[models.{{.Pascal}}](tx).
		Order(generated.{{.Pascal}}.ID.Desc()).
		Limit(limit).
		Offset(offset).
		Find(ctx)
	if err != nil {
		return nil, err
	}
	out := make([]*models.{{.Pascal}}, len({{.Plural}}))
	for i := range {{.Plural}} {
		out[i] = &{{.Plural}}[i]
