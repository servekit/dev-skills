syntax = "proto3";

package {{.Name}}.v1;

option go_package = "{{.Module}}/gen/{{.Name}}/v1;{{.Name}}servicev1";

import "google/api/annotations.proto";
import "google/protobuf/empty.proto";
import "buf/validate/validate.proto";
{{if .Example}}
// {{.Pascal}}Status is the lifecycle state of a {{.Pascal}} record.
//
// Conventions (see golang-service-development skill, enum.md):
//   - Enums live in proto, not in Go source.
//   - DB stores the underlying int32; cast via Go type assertion
//     ({{.Name}}v1.{{.Pascal}}Status(i) / int32(e)). proto also generates String(),
//     {{.Pascal}}Status_name, {{.Pascal}}Status_value — do NOT write custom
//     int↔enum / string↔enum helpers.
enum {{.Pascal}}Status {
  {{.NameUpper}}_STATUS_UNSPECIFIED = 0;
  {{.NameUpper}}_STATUS_ACTIVE = 1;
  {{.NameUpper}}_STATUS_ARCHIVED = 2;
}

// {{.Pascal}} represents a single record in the {{.Name}} service.
message {{.Pascal}} {
  int64 id = 1;
  string name = 2;
  string description = 3;
  // Unix milliseconds.
  int64 created_at = 4;
  // Unix milliseconds.
  int64 updated_at = 5;
  {{.Pascal}}Status status = 6;
}

message Create{{.Pascal}}Request {
  string name = 1 [(buf.validate.field) = {string: {min_len: 1, max_len: 100}}];
  string description = 2 [(buf.validate.field) = {string: {max_len: 500}}];
  // defined_only rejects values outside the enum (e.g., 99). UNSPECIFIED (0)
  // is allowed by the rule; service layer rejects it explicitly to require a
  // concrete state at creation.
  {{.Pascal}}Status status = 3 [(buf.validate.field) = {enum: {defined_only: true}}];
}

message Get{{.Pascal}}Request {
  int64 id = 1 [(buf.validate.field) = {int64: {gt: 0}}];
}

message List{{.Pascal}}sRequest {
  int32 page_size = 1 [(buf.validate.field) = {int32: {lte: 100, gte: 0}}];
  // Exclusively-named cursor: optional opaque token returned by previous List.
  string page_token = 2;
}

message List{{.Pascal}}sResponse {
  repeated {{.Pascal}} {{.Plural}} = 1;
  string next_page_token = 2;
}

message Update{{.Pascal}}Request {
  int64 id = 1 [(buf.validate.field) = {int64: {gt: 0}}];
  string name = 2 [(buf.validate.field) = {string: {min_len: 1, max_len: 100}}];
  string description = 3 [(buf.validate.field) = {string: {max_len: 500}}];
  // defined_only rejects values outside the enum. UNSPECIFIED (0) is allowed
  // by the rule; service layer rejects it explicitly.
  {{.Pascal}}Status status = 4 [(buf.validate.field) = {enum: {defined_only: true}}];
}

message Delete{{.Pascal}}Request {
  int64 id = 1 [(buf.validate.field) = {int64: {gt: 0}}];
}
{{end}}
// Pong is the health-check response — only public, non-sensitive info
// (service name, build version, status, timestamps). Never include internal
// addresses, IPs, env vars, secrets, or dependency topology here.
message Pong {
  string service = 1;       // service name, e.g. "demo-service"
  string version = 2;       // semantic version (ldflags; "dev" by default)
  string git_commit = 3;    // short commit hash (ldflags or VCS-embedded)
  string git_branch = 4;    // git branch (ldflags)
  string build_time = 5;    // build time, RFC3339 UTC (ldflags)
  string go_version = 6;    // Go toolchain version (runtime, not injected)
  string status = 7;        // "SERVING" when serving normally
  int64 now = 8;            // server time, Unix millis
  int64 started_at = 9;     // process start time, Unix millis (client computes uptime)
}

service {{.Pascal}}Service {
  rpc Ping(google.protobuf.Empty) returns (Pong) {
    option (google.api.http) = { get: "/ping" };
  }

{{if .Example}}  rpc Create{{.Pascal}}(Create{{.Pascal}}Request) returns ({{.Pascal}}) {
    option (google.api.http) = {
      post: "/v1/{{.Plural}}"
      body: "*"
    };
  }

  rpc Get{{.Pascal}}(Get{{.Pascal}}Request) returns ({{.Pascal}}) {
    option (google.api.http) = {get: "/v1/{{.Plural}}/{id}"};
  }

  rpc List{{.Pascal}}s(List{{.Pascal}}sRequest) returns (List{{.Pascal}}sResponse) {
    option (google.api.http) = {get: "/v1/{{.Plural}}"};
  }

  rpc Update{{.Pascal}}(Update{{.Pascal}}Request) returns ({{.Pascal}}) {
    option (google.api.http) = {
      put: "/v1/{{.Plural}}/{id}"
      body: "*"
    };
  }

  rpc Delete{{.Pascal}}(Delete{{.Pascal}}Request) returns (google.protobuf.Empty) {
    option (google.api.http) = {delete: "/v1/{{.Plural}}/{id}"};
  }
{{end}}}
